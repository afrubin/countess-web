{
  "name": "countess-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript openapi.json -o src/api-schema.ts",
    "check:api": "node scripts/check-api.mjs",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run check:api && vue-tsc --noEmit && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "*",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.0",
    "vitest": "*",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
